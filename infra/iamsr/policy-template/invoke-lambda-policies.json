{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Action": "lambda:InvokeFunction",
            "Resource": [
                "arn:aws:lambda:${aws_region}:${account_id}:function:${function_name}",
                "arn:aws:lambda:${aws_region}:${account_id}:function:${function_name}:*"
            ],
            "Effect": "Allow"
        }
    ]
}
